# Names only. Real values live in the hosting provider's env vars, never in the repo.
APP_ENV=dev
# HMAC key for signed download links (long random string)
SECRET_KEY=
PUBLIC_BASE_URL=
DATABASE_URL=
SOFFICE_BIN=
STORAGE_BACKEND=local
STORAGE_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANTHROPIC_API_KEY=
# fake (dev, no keys) | stripe. Test-mode keys (sk_test_...) only until go-live.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# set to 1 only at go-live (Henry); live keys are refused otherwise
ALLOW_LIVE_PAYMENTS=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_EMAIL=
