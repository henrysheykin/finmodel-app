# Names only. Real values live in the hosting provider's env vars, never in the repo.
APP_ENV=dev
# HMAC key for signed download links (long random string)
SECRET_KEY=
PUBLIC_BASE_URL=
DATABASE_URL=
SOFFICE_BIN=
STORAGE_BACKEND=local
STORAGE_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
# OpenAI model for the LLM brief builder: gpt-6-luna | gpt-6.1-sol | gpt-6-astra;
# empty = LLM off (briefs from template defaults + key numbers). Unknown values stop the app at start.
BRIEF_MODEL=
# fake (dev, no keys) | stripe. Test-mode keys (sk_test_...) only until go-live.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# set to 1 only at go-live (Henry); live keys are refused otherwise
ALLOW_LIVE_PAYMENTS=
# console (dev: emails go to the log) | resend | postmark
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
# admin panel /admin is disabled while ADMIN_USER or ADMIN_PASSWORD is empty; password 12+ characters
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# new orders and checkout sessions per client IP per 10 minutes (default 30; 0 = off)
RATE_LIMIT_PER_10MIN=
# header the host's edge proxy sets to the visitor's address (Railway: X-Real-IP); empty = proxy-derived peer
CLIENT_IP_HEADER=
# DEBUG | INFO | WARNING (default INFO)
LOG_LEVEL=
# set by Railway; the container listens on it (default 8000)
PORT=
